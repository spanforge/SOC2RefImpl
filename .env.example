# SpanForge SOC 2 Reference Implementation — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit a .env file with real secrets to version control.

# ---------------------------------------------------------------------------
# SpanForge Cloud (optional — leave blank to use local fallback mode)
# ---------------------------------------------------------------------------
SPANFORGE_API_KEY=
SPANFORGE_ENDPOINT=

# ---------------------------------------------------------------------------
# Project identity
# ---------------------------------------------------------------------------
SPANFORGE_PROJECT_ID=meridian-loan-summary

# ---------------------------------------------------------------------------
# HMAC signing key for the CC9.2 audit chain.
# Must be at least 32 characters long.
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
SPANFORGE_SIGNING_KEY=

# ---------------------------------------------------------------------------
# OTel / Datadog (optional — for A1.2 availability metrics)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# Pipeline tuning
# ---------------------------------------------------------------------------
# Confidence threshold below which a response is routed to human review (CC7.4)
CONFIDENCE_THRESHOLD=0.82

# Z-score threshold for behavioural drift alerts (CC7.2)
DRIFT_Z_THRESHOLD=3.0

# Local audit output directory (used when SPANFORGE_API_KEY is empty)
AUDIT_OUTPUT_DIR=./audit_output
